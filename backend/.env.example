APP_NAME="Vida Financeira"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=vida_financeira
DB_USERNAME=vida_financeira_app
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
FRONTEND_ORIGEM=http://localhost:3000

# Gerar 32 bytes aleatorios e codificar em Base64; nunca versionar o valor real.
JWT_SEGREDO_BASE64=
JWT_EMISSOR=http://localhost:8000
JWT_PUBLICO=vida-financeira-api
JWT_DURACAO_MINUTOS=15
JWT_RENOVACAO_DIAS=7

# Ative somente após configurar planos, credenciais de teste e webhooks.
ASSINATURAS_ACESSO_OBRIGATORIO=true
MERCADO_PAGO_ASSINATURAS_ATIVO=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BACK_URL=http://localhost:3000/assinatura

