# Copie para .env.docker e troque todos os segredos antes de iniciar.
DB_DATABASE=vida_financeira
DB_USERNAME=vida_financeira_app
DB_PASSWORD=troque-por-uma-senha-longa
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-longa

# Gere com: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=base64:TROQUE_POR_UMA_CHAVE_DE_32_BYTES
# Gere com: php -r "echo base64_encode(random_bytes(32)).PHP_EOL;"
JWT_SEGREDO_BASE64=TROQUE_POR_UM_SEGREDO_DE_32_BYTES_EM_BASE64
JWT_EMISSOR=http://localhost:8000
JWT_PUBLICO=vida-financeira-api
JWT_DURACAO_MINUTOS=15
JWT_RENOVACAO_DIAS=7

ASSINATURAS_ACESSO_OBRIGATORIO=false
MERCADO_PAGO_ASSINATURAS_ATIVO=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BACK_URL=http://localhost:3000/assinatura

# SMTP é obrigatório para recuperação de senha fora do ambiente local.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=nao-responda@localhost
MAIL_FROM_NAME="Vida Financeira"
